<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Админ России</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#0a0c11;color:#e6ecf5;padding:10px;font-size:14px;min-height:100vh}
header{background:#161b25;padding:10px;border-radius:10px;margin-bottom:10px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;position:sticky;top:10px;z-index:10}
.logo{font-weight:800;color:#fff;font-size:15px}
.stat{background:#1d2431;padding:6px 10px;border-radius:8px;font-size:12px}
.stat b{color:#2b6cff}
button{background:#1d2431;color:#e6ecf5;border:1px solid #262e3d;padding:8px 12px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px;margin:2px}
button:hover{border-color:#d52b1e}
button.active{background:#d52b1e;border-color:#d52b1e;color:#fff}
button.danger{background:#ef4444;border-color:#ef4444;color:#fff}
button.good{background:#22c55e;border-color:#22c55e;color:#fff}
button.blue{background:#2b6cff;border-color:#2b6cff;color:#fff}
.tabs{display:flex;gap:6px;margin-bottom:12px;overflow-x:auto;padding-bottom:4px}
.tabs button{flex-shrink:0}
.page{display:none}
.page.active{display:block}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px}
.card{background:#161b25;border:1px solid #262e3d;border-radius:10px;padding:10px}
.card h4{font-size:13px;margin-bottom:6px}
.card .sub{font-size:11px;color:#7f8a9e;margin-bottom:6px}
.card .big{font-size:20px;font-weight:800;margin:4px 0}
.bar{height:6px;background:#0a0c11;border-radius:3px;overflow:hidden;margin:4px 0}
.bar > div{height:100%;background:#2b6cff;transition:width .3s}
h3.sec{margin:16px 0 10px;color:#7f8a9e;font-size:13px;text-transform:uppercase;letter-spacing:1px}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:100;display:none;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.overlay.open{display:flex}
.modal{background:#161b25;border-radius:14px;padding:20px;max-width:700px;width:100%;max-height:90vh;overflow-y:auto;border:1px solid #262e3d}
.modal h2{margin-bottom:14px;font-size:18px}
.pick{background:#1d2431;border:1px solid #262e3d;border-radius:10px;padding:12px;margin-bottom:8px;cursor:pointer}
.pick:hover{border-color:#d52b1e}
.log{background:#161b25;border-radius:10px;padding:8px;max-height:300px;overflow-y:auto;font-size:12px}
.log div{padding:5px 8px;border-bottom:1px solid #262e3d}
.log div:last-child{border-bottom:none}
</style>
</head>
<body>
<header>
<div class="logo">🇷🇺 АДМИН РОССИИ</div>
<div class="stat">👥 <b id="pop">146M</b></div>
<div class="stat">💰 <b id="budget">300K</b></div>
<div class="stat">⚡ <b id="power">100</b></div>
<div class="stat">⭐ <b id="rep">50</b></div>
<div class="stat">😠 <b id="disc">0%</b></div>
</header>

<div class="tabs" id="tabs">
<button class="active" data-p="stats">📊 Статистика</button>
<button data-p="apps">📱 Приложения</button>
<button data-p="parties">🗳️ Партии</button>
<button data-p="war">🌍 Война</button>
</div>

<div class="page active" id="p-stats"></div>
<div class="page" id="p-apps"></div>
<div class="page" id="p-parties"></div>
<div class="page" id="p-war"></div>

<div class="overlay" id="overlay">
<div class="modal" id="modal"></div>
</div>

<script>
const state={
pop:146150000,budget:300000,tech:0,rep:50,disc:0,
blocked:{},parties:[],countries:[],wars:new Set(),alliances:new Set(),
myParty:null,rulingParty:null,
date:{d:1,m:1,y:1},gameStarted:false,log:[]
};

const APPS=[
['instagram','📷','Instagram'],['tiktok','🎵','TikTok'],['facebook','📘','Facebook'],
['youtube','▶️','YouTube'],['twitter','🐦','X (Twitter)'],['telegram','✈️','Telegram'],
['whatsapp','💬','WhatsApp'],['netflix','🎬','Netflix'],['spotify','🎧','Spotify'],
['google','🔍','Google'],['apple','🍎','Apple'],['microsoft','🪟','Microsoft'],
['steam','🕹️','Steam'],['chatgpt','🤖','ChatGPT'],['uber','🚕','Uber'],
['netflix','🎬','Netflix'],['tinder','🔥','Tinder'],['paypal','💳','PayPal'],
['vk','🅥','ВКонтакте','ru'],['yandex','🔴','Яндекс','ru'],['max','💠','MAX','ru'],
['rutube','📺','RUTUBE','ru'],['gosuslugi','🏛️','Госуслуги','ru'],['ok','🟠','Одноклассники','ru'],
['mailru','📧','Mail.ru','ru'],['sferum','📚','Сферум','ru'],['kaspersky','🛡️','Kaspersky','ru']
];

const PARTIES=[
['er','🐻','Единая Россия',45],['kprf','🔨','КПРФ',19],['ldpr','🦅','ЛДПР',9],
['sr','🌾','Справедливая Россия',7],['nl','🌱','Новые люди',6],['yabloko','🍎','Яблоко',3],
['rodina','🏰','Родина',2],['zelenye','🌿','Зелёные',2],['rost','📈','Партия Роста',2]
];

const COUNTRIES=[
['us','🇺🇸','США',100],['cn','🇨🇳','Китай',95],['gb','🇬🇧','Британия',72],
['fr','🇫🇷','Франция',66],['de','🇩🇪','Германия',62],['in','🇮🇳','Индия',64],
['jp','🇯🇵','Япония',56],['tr','🇹🇷','Турция',52],['ua','🇺🇦','Украина',44],
['pl','🇵🇱','Польша',41],['it','🇮🇹','Италия',44],['kz','🇰🇿','Казахстан',26],
['by','🇧🇾','Беларусь',21],['ge','🇬🇪','Грузия',15],['am','🇦🇲','Армения',12]
];

state.parties=PARTIES.map(p=>({id:p[0],i:p[1],n:p[2],votes:p[3]}));
state.countries=COUNTRIES.map(c=>({id:c[0],i:c[1],n:c[2],power:c[3]}));

const $=s=>document.querySelector(s);
const fmt=n=>Math.floor(n).toLocaleString('ru-RU');
const fmtS=n=>{if(n>=1e9)return(n/1e9).toFixed(1)+'B';if(n>=1e6)return(n/1e6).toFixed(1)+'M';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return Math.floor(n)};

function addLog(icon,text){
  state.log.unshift({icon,text,time:new Date().toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'})});
  if(state.log.length>50)state.log.pop();
}
function toast(msg,color){
  const t=document.createElement('div');
  t.style.cssText='position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:'+(color||'#22c55e')+';color:#fff;padding:10px 20px;border-radius:10px;z-index:999;font-weight:700;box-shadow:0 4px 20px rgba(0,0,0,.5)';
  t.textContent=msg;document.body.appendChild(t);
  setTimeout(()=>t.remove(),2000);
}
function updateHeader(){
  $('#pop').textContent=fmtS(state.pop);
  $('#budget').textContent=fmtS(state.budget);
  $('#power').textContent=100+state.tech+state.alliances.size*3;
  $('#rep').textContent=Math.round(state.rep);
  $('#disc').textContent=Math.round(state.disc)+'%';
}
function getPower(){return 100+state.tech+state.alliances.size*3}

document.querySelectorAll('#tabs button').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('#tabs button').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    $('#p-'+b.dataset.p).classList.add('active');
    render[b.dataset.p]();
  };
});

const render={
stats(){
  const iRule=!state.rulingParty||state.rulingParty===state.myParty;
  $('#p-stats').innerHTML=`
    <div class="grid">
      <div class="card"><h4>👥 Население</h4><div class="big" style="color:#2b6cff">${fmt(state.pop)}</div></div>
      <div class="card"><h4>💰 Бюджет</h4><div class="big" style="color:#22c55e">₽${fmtS(state.budget)}</div></div>
      <div class="card"><h4>⚡ Мощь</h4><div class="big" style="color:#f5a524">${getPower()}</div></div>
      <div class="card"><h4>⭐ Репутация</h4><div class="big" style="color:${state.rep>=70?'#22c55e':state.rep>=40?'#f5a524':'#ef4444'}">${Math.round(state.rep)}</div></div>
      <div class="card"><h4>😠 Недовольство</h4><div class="big" style="color:${state.disc>=70?'#ef4444':'#22c55e'}">${Math.round(state.disc)}%</div></div>
      <div class="card"><h4>📅 Дата</h4><div class="big" style="font-size:16px">Год ${state.date.y}</div><div class="sub">${state.date.d} дн, ${state.date.m} мес</div></div>
    </div>
    <h3 class="sec">Политика</h3>
    <div class="grid">
      <div class="card"><h4>Ваша партия</h4><div>${state.myParty?state.parties.find(p=>p.id===state.myParty).n:'—'}</div></div>
      <div class="card"><h4>Правящая</h4><div>${state.rulingParty?state.parties.find(p=>p.id===state.rulingParty).n:'—'}</div></div>
      <div class="card"><h4>У власти</h4><div style="color:${iRule?'#22c55e':'#ef4444'};font-weight:800">${iRule?'✅ ВЫ':'⚠️ ИИ'}</div></div>
      <div class="card"><h4>⚔️ Войн</h4><div class="big">${state.wars.size}</div></div>
      <div class="card"><h4>🤝 Союзов</h4><div class="big">${state.alliances.size}</div></div>
      <div class="card"><h4>🚫 Забанено</h4><div class="big">${Object.keys(state.blocked).length}</div></div>
    </div>
    <h3 class="sec">Лог событий</h3>
    <div class="log">${state.log.map(l=>`<div>${l.icon} ${l.text} <span style="color:#7f8a9e;float:right">${l.time}</span></div>`).join('')||'<div style="text-align:center;color:#7f8a9e">Пусто</div>'}</div>
  `;
},
apps(){
  const blocked=Object.keys(state.blocked).length;
  $('#p-apps').innerHTML=`
    <h3 class="sec" style="margin-top:0">Приложения — ${APPS.length} · Забанено: ${blocked}</h3>
    <div class="grid">${APPS.map(a=>{
      const [id,icon,name,flag]=a;
      const act=state.blocked[id];
      return `<div class="card"><h4>${icon} ${name}${flag==='ru'?' 🇷🇺':''}</h4>
        <div class="sub">${act?'🚫 Заблокировано':'🟢 Работает'}</div>
        <button data-id="${id}" class="${act?'good':'danger'}">${act?'↩️ Разблокировать':'🚫 Заблокировать'}</button>
      </div>`;
    }).join('')}</div>
  `;
  $('#p-apps').querySelectorAll('button[data-id]').forEach(b=>{
    b.onclick=()=>{
      const id=b.dataset.id;
      if(state.blocked[id]){delete state.blocked[id];toast('↩️ Разблокировано');state.rep=Math.min(100,state.rep+1);state.disc=Math.max(0,state.disc-2);addLog('↩️','Разблокировано '+APPS.find(a=>a[0]===id)[2]);}
      else{state.blocked[id]='ban';toast('🚫 Забанено','#ef4444');state.pop-=1000;state.rep=Math.max(0,state.rep-2);state.disc=Math.min(100,state.disc+5);addLog('🚫','Забанено '+APPS.find(a=>a[0]===id)[2]);}
      updateHeader();render.apps();
    };
  });
},
parties(){
  const max=Math.max(...state.parties.map(p=>p.votes));
  $('#p-parties').innerHTML=`
    <h3 class="sec" style="margin-top:0">Партии — ${state.parties.length}</h3>
    <div class="grid">${state.parties.map(p=>{
      const isMine=p.id===state.myParty;
      const isRuling=p.id===state.rulingParty;
      return `<div class="card" style="${isMine?'border-color:#d52b1e':''}"><h4>${p.i} ${p.n} ${isMine?'⭐':''} ${isRuling?'👑':''}</h4>
        <div class="bar"><div style="width:${(p.votes/max)*100}%;background:${isMine?'#d52b1e':'#2b6cff'}"></div></div>
        <div class="sub">Голоса: ${p.votes.toFixed(1)}%</div>
        <button data-id="${p.id}" class="good">+1%</button>
        <button data-id="${p.id}" data-reset class="blue">↺</button>
      </div>`;
    }).join('')}</div>
  `;
  $('#p-parties').querySelectorAll('button[data-id]').forEach(b=>{
    b.onclick=()=>{
      const p=state.parties.find(x=>x.id===b.dataset.id);
      if(b.hasAttribute('data-reset')){p.votes=PARTIES.find(x=>x[0]===p.id)[3];}
      else{p.votes+=1;state.disc=Math.min(100,state.disc+1);}
      updateHeader();render.parties();
    };
  });
},
war(){
  $('#p-war').innerHTML=`
    <h3 class="sec" style="margin-top:0">Страны — ${state.countries.length} · Войн: ${state.wars.size} · Союзов: ${state.alliances.size}</h3>
    <div class="grid">${state.countries.map(c=>{
      const atWar=state.wars.has(c.id);
      const allied=state.alliances.has(c.id);
      return `<div class="card" style="${atWar?'border-color:#ef4444':allied?'border-color:#22c55e':''}"><h4>${c.i} ${c.n}</h4>
        <div class="bar"><div style="width:${Math.min(100,c.power)}%;background:${atWar?'#ef4444':allied?'#22c55e':'#2b6cff'}"></div></div>
        <div class="sub">Мощь: ${c.power}</div>
        ${atWar?`<button data-id="${c.id}" data-act="peace" class="good">🕊️ Мир</button>`:
          allied?`<button data-id="${c.id}" data-act="leave" class="danger">💔 Разорвать</button>`:
          `<button data-id="${c.id}" data-act="war" class="danger">⚔️ Война</button>
           <button data-id="${c.id}" data-act="ally" class="${getPower()>=c.power*1.5?'good':''}">🤝 Союз</button>`}
      </div>`;
    }).join('')}</div>
  `;
  $('#p-war').querySelectorAll('button[data-id]').forEach(b=>{
    b.onclick=()=>{
      const id=b.dataset.id;const act=b.dataset.act;
      const c=state.countries.find(x=>x.id===id);
      if(act==='war'){state.wars.add(id);state.pop-=1000;state.disc=Math.min(100,state.disc+8);addLog('⚔️','Война с '+c.n);toast('⚔️ Война!','#ef4444');}
      else if(act==='peace'){state.wars.delete(id);state.disc=Math.max(0,state.disc-5);addLog('🕊️','Мир с '+c.n);toast('🕊️ Мир');}
      else if(act==='leave'){state.alliances.delete(id);addLog('💔','Разрыв с '+c.n);toast('💔 Разрыв','#ef4444');}
      else if(act==='ally'){
        if(getPower()>=c.power*1.5){state.alliances.add(id);addLog('🤝','Союз с '+c.n);toast('🤝 Союз!');}
        else toast('❌ Мало мощи','#ef4444');
      }
      updateHeader();render.war();
    };
  });
}
};

function openModal(html){
  $('#modal').innerHTML=html;
  $('#overlay').classList.add('open');
}
$('#overlay').onclick=e=>{if(e.target===$('#overlay'))$('#overlay').classList.remove('open');};

function startGame(){
  openModal('<h2>🗳️ Выберите партию</h2>'+
    PARTIES.map(p=>`<div class="pick" data-pid="${p[0]}">
      <div style="font-weight:800;font-size:15px">${p[1]} ${p[2]}</div>
      <div style="color:#7f8a9e;font-size:12px;margin-top:4px">Рейтинг: ${p[3]}%</div>
    </div>`).join('')
  );
  $('#modal').querySelectorAll('.pick').forEach(el=>{
    el.onclick=()=>{
      state.myParty=el.dataset.pid;
      state.gameStarted=true;
      addLog('🎯','Выбрана партия: '+state.parties.find(p=>p.id===state.myParty).n);
      $('#overlay').classList.remove('open');
      toast('✅ Игра началась!');
      updateHeader();render.stats();
    };
  });
}

setInterval(()=>{
  if(!state.gameStarted)return;
  state.date.d++;
  if(state.date.d>30){state.date.d=1;state.date.m++;if(state.date.m>10){state.date.m=1;state.date.y++;}}
  state.budget+=500+state.alliances.size*300;
  if(state.disc>0)state.disc=Math.max(0,state.disc-0.05);
  if(Math.random()<0.005){
    const ev=Math.floor(Math.random()*4);
    if(ev===0){state.budget+=10000;addLog('💰','Случайный доход +₽10 000');}
    else if(ev===1){state.pop+=50000;addLog('👶','Прирост +50 000');}
    else if(ev===2){state.rep=Math.min(100,state.rep+1);addLog('⭐','Репутация +1');}
    else{state.disc=Math.min(100,state.disc+2);addLog('😠','Недовольство +2');}
  }
  if(state.date.d===1&&state.date.m===1){
    const winner=[...state.parties].sort((a,b)=>b.votes-a.votes)[0];
    state.rulingParty=winner.id;
    const iWon=winner.id===state.myParty;
    addLog(iWon?'🏆':'😔',iWon?'ВЫ ПОБЕДИЛИ!':'Победила '+winner.n);
    if(iWon){state.budget+=100000;state.rep=Math.min(100,state.rep+10);toast('🏆 ВЫ ПОБЕДИЛИ!');}
    else{state.disc=Math.min(100,state.disc+10);toast('😔 '+winner.n,'#ef4444');}
    state.parties.forEach(p=>p.votes=PARTIES.find(x=>x[0]===p.id)[3]+Math.random()*5);
  }
  updateHeader();
  const active=document.querySelector('.page.active');
  if(active)render[active.id.replace('p-','')]();
},1000);

updateHeader();
startGame();
</script>
</body>
</html>
